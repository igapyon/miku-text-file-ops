{
  "name": "miku-text-file-ops",
  "version": "0.4.1",
  "private": true,
  "description": "Encoding-aware local text file operations for AI agents",
  "type": "module",
  "files": [
    "dist/src",
    "docs",
    "licenses",
    "LICENSE"
  ],
  "bin": {
    "miku-text-file-ops": "dist/src/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:bundle": "npm run build && node scripts/build-cli-bundles.mjs",
    "check:version": "node scripts/check-version.mjs",
    "cli": "node dist/src/bin.js",
    "smoke:bundle": "node scripts/smoke-cli-bundle.mjs",
    "smoke:runtime": "node scripts/smoke-runtime-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run check:version && npm run build && node --test dist/test/**/*.test.js"
  },
  "dependencies": {
    "iconv-lite": "0.6.3"
  },
  "devDependencies": {
    "@types/node": "22.17.0",
    "esbuild": "0.28.1",
    "tar": "7.5.22",
    "typescript": "5.9.2"
  }
}
